{
  "name": "@acaprino/imago",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./css/*": "./css/*",
    "./icons/*": "./icons/*",
    "./ui": "./lib/ui/index.js",
    "./shell": "./lib/shell/index.js",
    "./tokens": "./tokens/imago.tokens.json",
    "./tauri": "./lib/tauri.js",
    "./graph": "./lib/graph.js",
    "./graph-layout": "./lib/graph-layout.js",
    "./react": "./react/index.js"
  },
  "bin": {
    "imago-check": "./scripts/check/cli.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts examples/demo/capture-rules.test.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/icons.mjs",
    "gallery": "vite --config gallery/vite.config.ts",
    "build": "npm run build:package && tsc --noEmit && vite build --config gallery/vite.config.ts",
    "test:gallery": "node tests/gallery/run.mjs",
    "demo": "cd examples/demo/src-tauri && tauri dev",
    "demo:web": "vite build --config gallery/vite.config.ts --outDir ../examples/demo/dist",
    "demo:build": "cd examples/demo/src-tauri && tauri build --debug --no-bundle --features custom-protocol",
    "demo:fetch": "node examples/demo/fetch.mjs",
    "capture": "node examples/demo/capture.mjs",
    "check": "node scripts/check/cli.mjs --package",
    "verify": "npm run tokens -- --check && npm test && npm run check && npm run build && npm run test:gallery && cargo test -p imago-shell",
    "prepare": "npm run build:package",
    "build:package": "tsc -p tsconfig.package.json",
    "pretest": "npm run build:package"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/react": "19.3.0",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "css",
    "docs",
    "tokens",
    "icons",
    "ts",
    "react",
    "scripts/check"
  ],
  "dependencies": {
    "d3-selection": "3.0.1",
    "d3-zoom": "3.0.1"
  }
}
