{
  "name": "@acaprino/imago",
  "version": "1.4.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./lib/index.js",
    "./icons/*": "./icons/*"
  },
  "bin": {
    "imago-check": "./scripts/check/cli.mjs"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts examples/demo/capture-rules.test.mjs",
    "icons": "node scripts/icons.mjs",
    "build": "npm run build:package && tsc --noEmit && npm run demo:web",
    "check": "sigrid-check ts && sigrid-check examples/demo/src",
    "test:demo": "node tests/demo.mjs",
    "test:install": "node tests/install.mjs",
    "demo": "cd examples/demo/src-tauri && tauri dev",
    "demo:serve": "vite --config examples/demo/vite.config.ts",
    "demo:web": "npm run build:package && vite build --config examples/demo/vite.config.ts",
    "demo:build": "cd examples/demo/src-tauri && tauri build --debug --no-bundle --features custom-protocol",
    "demo:fetch": "node examples/demo/fetch.mjs",
    "capture": "node examples/demo/capture.mjs",
    "verify": "npm run build && npm run check && npm run test:demo && npm test && npm run test:install && cargo test -p imago-shell",
    "prepack": "npm run build:package",
    "build:package": "tsc -p tsconfig.package.json",
    "pretest": "npm run build:package"
  },
  "devDependencies": {
    "@acaprino/sigrid": "https://github.com/acaprino/sigrid/releases/download/v6.15.1/acaprino-sigrid-6.15.1.tgz",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "@acaprino/sigrid": "^6.15.1",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "lib",
    "docs",
    "icons",
    "scripts/check"
  ]
}
