  "accent": {
    "$description": "The accent of an app: the oklch values take the hue of the app (--im-hue) where a component is \"none\".",
    "dark": {
      "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, "none"] } },
      "accent-on": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0.04, "none"] } },
      "accent-hi": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.9, 0.08, "none"] } },
      "accent-text": { "$type": "color", "$value": "{accent.dark.accent}" },
      "accent-hover": { "$type": "color", "$value": "{accent.dark.accent}", "$extensions": { "imago": { "mix": { "percent": 84, "with": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } } } } }
    },
    "light": {
      "accent": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, "none"] } },
      "accent-on": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "accent-hi": { "$type": "color", "$value": "{accent.light.accent}" },
      "accent-text": { "$type": "color", "$value": "{accent.light.accent}" },
      "accent-hover": { "$type": "color", "$value": "{accent.light.accent}", "$extensions": { "imago": { "mix": { "percent": 86, "with": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } } } } }
    }
  },
  "category": {
    "$description": "Eight categorical colours (a chart series, a tag, a group), the same in every app: the lightness and the strength of the accent of the theme, a fixed hue each (they do not follow --im-hue), and one text colour, cat-on, for any of them. Each is also text on the sheet. sRGB cannot hold the strength of the accent at every hue: on dark at 25, 255 and 300, and on light at 75, 125, 170 and 215, the hex fallback clips to a strength of 0.09 to 0.12. The hue stays, so that a colour is the same in both themes; an oklch() browser shows the nearest colour its screen can.",
    "dark": {
      "cat-1": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 25] } },
      "cat-2": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 75] } },
      "cat-3": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 125] } },
      "cat-4": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 170] } },
      "cat-5": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 215] } },
      "cat-6": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 255] } },
      "cat-7": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 300] } },
      "cat-8": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.82, 0.12, 345] } },
      "cat-on": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0] } }
    },
    "light": {
      "cat-1": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 25] } },
      "cat-2": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 75] } },
      "cat-3": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 125] } },
      "cat-4": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 170] } },
      "cat-5": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 215] } },
      "cat-6": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 255] } },
      "cat-7": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 300] } },
      "cat-8": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.47, 0.13, 345] } },
      "cat-on": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } }
    }
