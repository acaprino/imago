{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Imago tokens. A key is the custom property without its --im- prefix. A colour of look.<look>.<theme> has the opaque value in $value and, where the surface is translucent under .im-glass, the glass value in $extensions.imago.glass.",
  "shared": {
    "$description": "Tokens that do not depend on the look.",
    "font-text": { "$type": "fontFamily", "$value": ["Segoe UI Variable Text", "Segoe UI", "system-ui", "sans-serif"] },
    "font-display": { "$type": "fontFamily", "$value": ["Bahnschrift", "Segoe UI Variable Display", "Segoe UI", "sans-serif"] },
    "font-code": { "$type": "fontFamily", "$value": ["Cascadia Mono", "Cascadia Code", "Consolas", "monospace"] },
    "fs-micro": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
    "fs-meta": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "fs-body": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
    "fs-title": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "fs-display": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
    "s-1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "s-2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "s-3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "s-4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "s-5": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "t-fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "t-base": { "$type": "duration", "$value": { "value": 180, "unit": "ms" } },
    "ease": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "w-sidebar": { "$type": "dimension", "$value": { "value": 232, "unit": "px" } },
    "w-rail": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
    "w-inspector": { "$type": "dimension", "$value": { "value": 300, "unit": "px" } }
  },
  "measure": {
    "smooth": {
      "h-titlebar": { "$type": "dimension", "$value": { "value": 46, "unit": "px" } },
      "h-control": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "h-control-sm": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "h-row": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "h-row-2": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
      "h-table-row": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
      "h-panel-header": { "$type": "dimension", "$value": { "value": 42, "unit": "px" } },
      "h-footer": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
      "r-chip": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "r-control": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "r-sheet": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
      "cut-sm": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "cut-md": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "cut-lg": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "font-head": { "$type": "fontFamily", "$value": "{shared.font-text}" },
      "case": { "$type": "string", "$value": "none" },
      "track": { "$type": "number", "$value": 0, "$extensions": { "imago": { "unit": "em" } } }
    },
    "oni": {
      "h-titlebar": { "$type": "dimension", "$value": { "value": 38, "unit": "px" } },
      "h-control": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "h-control-sm": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
      "h-row": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "h-row-2": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "h-table-row": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "h-panel-header": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "h-footer": { "$type": "dimension", "$value": { "value": 26, "unit": "px" } },
      "r-chip": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "r-control": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "r-sheet": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "cut-sm": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "cut-md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "cut-lg": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
      "font-head": { "$type": "fontFamily", "$value": "{shared.font-display}" },
      "case": { "$type": "string", "$value": "uppercase" },
      "track": { "$type": "number", "$value": 0.06, "$extensions": { "imago": { "unit": "em" } } }
    }
  },
  "app": {
    "shinatama": {
      "hue": { "$type": "number", "$value": 355 }
    },
    "xiox": {
      "hue": { "$type": "number", "$value": 75 }
    },
    "mukade": {
      "hue": { "$type": "number", "$value": 300 }
    },
    "muro": {
      "hue": { "$type": "number", "$value": 170 }
    },
    "daodan": {
      "hue": { "$type": "number", "$value": 235 }
    }
