{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imago demo",
  "identifier": "dev.imago.demo",
  "build": {
    "beforeDevCommand": "npm run demo:serve",
    "beforeBuildCommand": "npm run demo:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Imago demo",
        "width": 1180,
        "height": 760,
        "minWidth": 500,
        "minHeight": 500,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["default", "shell"]
    }
  },
  "bundle": { "active": false }
}
